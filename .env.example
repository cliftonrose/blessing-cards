# Copy to .env and fill in. .env is gitignored and must never be committed.

# GitHub account that owns the Pages repo, used by publish.sh
GITHUB_USER=your-github-username
GITHUB_API_TOKEN=your-github-token

# ElevenLabs, used only by scripts/generate-audio.js at build time.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-key

# Optional overrides — the script defaults to the Ash voice on eleven_v3.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v3
