# Copy to .env and fill in. .env is gitignored and must never be committed.

# GitHub account that owns the Pages repo, used by publish.sh
GITHUB_USER=your-github-username
GITHUB_API_TOKEN=your-github-token

# Crossway ESV API key, used only by scripts/fetch-verses.js at build time.
# Request one free at https://api.esv.org/
ESV_API_KEY=your-esv-api-key
